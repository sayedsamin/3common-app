{
  "openapi": "3.0.3",
  "info": {
    "title": "3Common API",
    "description": "Public REST API for the 3Common event management platform.",
    "version": "0.0.1",
    "contact": {
      "name": "3Common Support",
      "url": "https://help.3common.com"
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key as Bearer token"
      }
    }
  },
  "paths": {
    "/v1/orders/": {
      "get": {
        "summary": "List Orders",
        "tags": [
          "Orders"
        ],
        "description": "Lists the host's orders as the compact dashboard projection, filtered and\npaginated. Refunded/non-refunded and box-office are the same list with a\nfilter: pass refunded=true|false or isBoxOffice=true. Sorted by created\ndate descending.",
        "parameters": [
          {
            "schema": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number (0-based, default 0)"
          },
          {
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "in": "query",
            "name": "pageSize",
            "required": false,
            "description": "Items per page (default 20, max 500)"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "eventId",
            "required": false,
            "description": "Filter to one event"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "productSetId",
            "required": false,
            "description": "Filter to one product set"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "timeslotId",
            "required": false,
            "description": "Filter to one timeslot"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "contactId",
            "required": false,
            "description": "Filter to one contact"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "purchaserId",
            "required": false,
            "description": "Filter to one purchaser"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "orderNumber",
            "required": false,
            "description": "Exact order number"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "paid",
                "processing",
                "completed",
                "cancelled",
                "refunded"
              ]
            },
            "in": "query",
            "name": "orderStatus",
            "required": false,
            "description": "Filter by lifecycle status"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "booking",
                "ticket",
                "product"
              ]
            },
            "in": "query",
            "name": "type",
            "required": false,
            "description": "Filter by order type"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "status",
            "required": false,
            "description": "true = paid/completed orders only"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "refunded",
            "required": false,
            "description": "true = refunded only; false = non-refunded only"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "isBoxOffice",
            "required": false,
            "description": "true = box-office orders only"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "in": "query",
            "name": "sortDirection",
            "required": false,
            "description": "Sort by created date (default: desc)"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "customerName": {
                            "type": "string"
                          },
                          "firstName": {
                            "type": "string"
                          },
                          "lastName": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          },
                          "date": {
                            "description": "Order placed date (ISO 8601)",
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "booking",
                              "ticket",
                              "product"
                            ],
                            "description": "Order line type."
                          },
                          "amount": {
                            "type": "number",
                            "description": "Gross (total paid) in cents."
                          },
                          "quantity": {
                            "type": "number"
                          },
                          "status": {
                            "type": "boolean",
                            "description": "True for completed (paid) orders."
                          },
                          "orderStatus": {
                            "type": "string",
                            "enum": [
                              "pending",
                              "paid",
                              "processing",
                              "completed",
                              "cancelled",
                              "refunded"
                            ],
                            "description": "Order lifecycle status."
                          },
                          "paymentMethod": {
                            "type": "string"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "discount": {
                            "type": "number"
                          },
                          "fees": {
                            "type": "number"
                          },
                          "promos": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "refundedAmount": {
                            "type": "number"
                          },
                          "refLabel": {
                            "type": "string"
                          },
                          "walletLink": {
                            "type": "string"
                          },
                          "eventId": {
                            "type": "string"
                          },
                          "refunded": {
                            "type": "boolean"
                          },
                          "cancelled": {
                            "type": "boolean"
                          },
                          "isBoxOffice": {
                            "type": "boolean"
                          },
                          "manuallyAdded": {
                            "type": "boolean"
                          },
                          "comped": {
                            "type": "boolean"
                          },
                          "latestCharge": {
                            "type": "string"
                          },
                          "disputeStatus": {
                            "type": "string"
                          },
                          "accessCodes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "code": {
                                  "type": "string"
                                },
                                "benefitType": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "code"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "product_set_id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "customerName",
                          "firstName",
                          "lastName",
                          "email",
                          "amount",
                          "quantity",
                          "status",
                          "discount",
                          "fees",
                          "eventId"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "data",
                    "hasMore"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/kickback/balance": {
      "get": {
        "summary": "Get Kickback Balance",
        "tags": [
          "Orders"
        ],
        "description": "Returns the available and pending kickback balance grouped by currency, each bucket listing its contributing orders and tickets. Money is in cents.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "available_balance": {
                            "type": "object",
                            "properties": {
                              "kickback_balance": {
                                "type": "number",
                                "description": "Kickback total for this bucket, in cents."
                              },
                              "kickback_balance_orders": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "_id": {},
                                    "gross": {
                                      "type": "number"
                                    },
                                    "fees": {
                                      "type": "number"
                                    },
                                    "threeCFee": {
                                      "type": "number"
                                    },
                                    "stripeFee": {
                                      "type": "number"
                                    },
                                    "refundedAmount": {
                                      "type": "number"
                                    },
                                    "latest_charge": {
                                      "type": "string"
                                    },
                                    "event_id": {
                                      "type": "string"
                                    }
                                  },
                                  "additionalProperties": {}
                                }
                              },
                              "currency": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "kickback_balance",
                              "kickback_balance_orders",
                              "currency"
                            ],
                            "additionalProperties": false
                          },
                          "pending_balance": {
                            "type": "object",
                            "properties": {
                              "kickback_balance": {
                                "type": "number",
                                "description": "Kickback total for this bucket, in cents."
                              },
                              "kickback_balance_orders": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "_id": {},
                                    "gross": {
                                      "type": "number"
                                    },
                                    "fees": {
                                      "type": "number"
                                    },
                                    "threeCFee": {
                                      "type": "number"
                                    },
                                    "stripeFee": {
                                      "type": "number"
                                    },
                                    "refundedAmount": {
                                      "type": "number"
                                    },
                                    "latest_charge": {
                                      "type": "string"
                                    },
                                    "event_id": {
                                      "type": "string"
                                    }
                                  },
                                  "additionalProperties": {}
                                }
                              },
                              "currency": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "kickback_balance",
                              "kickback_balance_orders",
                              "currency"
                            ],
                            "additionalProperties": false
                          },
                          "currency": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "available_balance",
                          "pending_balance",
                          "currency"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/kickback/total": {
      "get": {
        "summary": "Get Kickback Total",
        "tags": [
          "Orders"
        ],
        "description": "Returns the sum of kickback across the host's active, not-on-hold orders, in cents.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/checkout/{id}/details": {
      "get": {
        "summary": "Get Checkout Details",
        "tags": [
          "Orders"
        ],
        "description": "Returns a product set's products (grouped by type) with inventory, plus every order and ticket for that set.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Product set ID"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "products": {
                          "type": "object",
                          "properties": {
                            "mode": {
                              "type": "string",
                              "enum": [
                                "product-set"
                              ]
                            },
                            "data": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": {}
                              },
                              "description": "One entry per set: { productSetId, productsByType }"
                            },
                            "inventoryByProductId": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              }
                            }
                          },
                          "required": [
                            "mode",
                            "data",
                            "inventoryByProductId"
                          ],
                          "additionalProperties": false
                        },
                        "tickets": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {}
                          },
                          "description": "All tickets for the product set"
                        },
                        "orders": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {}
                          },
                          "description": "All orders for the product set"
                        }
                      },
                      "required": [
                        "products",
                        "tickets",
                        "orders"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Orders"
    }
  ]
}
